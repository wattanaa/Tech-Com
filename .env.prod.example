# ════════════════════════════════════════════════════════════════
#  TCOM — ตั้งค่าสำหรับ deploy ด้วย Docker Compose
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ครบก่อนรัน
#      cp .env.prod.example .env
#  ห้าม commit ไฟล์ .env เข้า git เด็ดขาด
# ════════════════════════════════════════════════════════════════

# ── ฐานข้อมูล ──
POSTGRES_USER=tcom
POSTGRES_DB=tcom_db
# ตั้งรหัสผ่านที่คาดเดายาก
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านนี้ให้ปลอดภัย

# ── ความลับของ session ──
# สร้างค่าสุ่มด้วยคำสั่ง:
#   docker run --rm node:20-slim node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── บัญชีผู้ดูแลระบบ (สร้างให้อัตโนมัติตอน seed ครั้งแรก) ──
SEED_ADMIN_EMAIL=admin@tcom.rtc.ac.th
# ต้องยาวอย่างน้อย 12 ตัวอักษร และควรเปลี่ยนทันทีหลังเข้าระบบครั้งแรก
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# ── ข้อมูลตั้งต้น ──
# core = เฉพาะข้อมูลแกนระบบ (ใช้จริง) · demo = รวมข้อมูลตัวอย่างให้ลองเล่น · none = ไม่ใส่
SEED_MODE=demo

# ── เครือข่าย ──
# พอร์ตที่เปิดให้เข้าเว็บจากภายนอก (ค่าปกติ 80)
WEB_PORT=80
# โดเมน/URL ที่ผู้ใช้เปิดเว็บ — ตั้งให้ตรงกับที่ใช้จริงตอนขึ้น production เพื่อความปลอดภัยของ CORS
# เช่น https://tcom.rtc.ac.th
CORS_ORIGIN=http://localhost
